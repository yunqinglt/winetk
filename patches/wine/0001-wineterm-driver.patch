diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index b0b2392c504765cd89289af576c91e7bd609d790..6b7b84eb79d25a860bcf6a309c7752d4bfe51194 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -2259,6 +2259,66 @@ done:
 }
 
 
+/* Opt-in Steam bridge for the terminal build. As in Valve Proton's loader,
+ * preserve the installed Windows steamclient image and redirect its exported
+ * entry points to lsteamclient, which calls the running Linux Steam client.
+ * The native client implementation and its DllMain must never run. */
+static NTSTATUS winetk_steam_bridge( WINE_MODREF *wm, LPCWSTR load_path )
+{
+    UNICODE_STRING name = RTL_CONSTANT_STRING( L"WINETK_STEAM_BRIDGE" );
+    WCHAR buffer[4];
+    UNICODE_STRING value = {0, sizeof(buffer), buffer};
+    UNICODE_STRING bridge = RTL_CONSTANT_STRING( L"lsteamclient.dll" );
+    HMODULE target;
+    const IMAGE_EXPORT_DIRECTORY *exports;
+    const IMAGE_NT_HEADERS *nt = RtlImageNtHeader( wm->ldr.DllBase );
+    const DWORD *names;
+    ULONG size, i, patched = 0;
+
+    if (wcsicmp( wm->ldr.BaseDllName.Buffer, L"steamclient.dll" ) &&
+        wcsicmp( wm->ldr.BaseDllName.Buffer, L"steamclient64.dll" )) return STATUS_NOT_SUPPORTED;
+    if (RtlQueryEnvironmentVariable_U( NULL, &name, &value ) || !value.Length || buffer[0] != '1')
+        return STATUS_NOT_SUPPORTED;
+    if (LdrLoadDll( load_path, 0, &bridge, &target )) return STATUS_DLL_NOT_FOUND;
+    exports = RtlImageDirectoryEntryToData( wm->ldr.DllBase, TRUE, IMAGE_DIRECTORY_ENTRY_EXPORT, &size );
+    if (!exports) return STATUS_INVALID_IMAGE_FORMAT;
+    names = get_rva( wm->ldr.DllBase, exports->AddressOfNames );
+    for (i = 0; i < exports->NumberOfNames; ++i)
+    {
+        const char *symbol = get_rva( wm->ldr.DllBase, names[i] );
+        BYTE *source = RtlFindExportedRoutineByName( wm->ldr.DllBase, symbol );
+        void *dest = RtlFindExportedRoutineByName( target, symbol );
+        BOOL x64 = nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC;
+        SIZE_T length = x64 ? 12 : 7;
+        void *address = source;
+        DWORD old, ignored;
+        if (!source || !dest) continue;
+        if (NtProtectVirtualMemory( NtCurrentProcess(), &address, &length, PAGE_EXECUTE_READWRITE, &old ))
+            return STATUS_ACCESS_DENIED;
+        /* mov rax/eax, destination; jmp rax/eax */
+        if (x64)
+        {
+            ULONGLONG pointer = (ULONG_PTR)dest;
+            source[0] = 0x48; source[1] = 0xb8;
+            memcpy( source + 2, &pointer, sizeof(pointer) );
+            source[10] = 0xff; source[11] = 0xe0;
+        }
+        else
+        {
+            ULONG pointer = (ULONG_PTR)dest;
+            source[0] = 0xb8;
+            memcpy( source + 1, &pointer, sizeof(pointer) );
+            source[5] = 0xff; source[6] = 0xe0;
+        }
+        NtProtectVirtualMemory( NtCurrentProcess(), &address, &length, old, &ignored );
+        ++patched;
+    }
+    NtFlushInstructionCache( NtCurrentProcess(), wm->ldr.DllBase, nt->OptionalHeader.SizeOfImage );
+    TRACE( "WineTK Steam bridge %s: %lu exports redirected\n", debugstr_w(wm->ldr.BaseDllName.Buffer), patched );
+    return patched ? STATUS_SUCCESS : STATUS_PROCEDURE_NOT_FOUND;
+}
+
+
 /*************************************************************************
  *		build_module
  *
@@ -2296,6 +2356,13 @@ static NTSTATUS build_module( LPCWSTR load_path, const UNICODE_STRING *nt_name,
 
     update_load_config( *module );
 
+    if (!is_builtin)
+    {
+        status = winetk_steam_bridge( wm, load_path );
+        if (!status) flags |= LDR_DONT_RESOLVE_REFS;
+        else if (status != STATUS_NOT_SUPPORTED) goto failed_imports;
+    }
+
     /* fixup imports */
 
     if (!(flags & LDR_DONT_RESOLVE_REFS) &&
@@ -2308,6 +2375,7 @@ static NTSTATUS build_module( LPCWSTR load_path, const UNICODE_STRING *nt_name,
             status = fixup_imports( wm, load_path );
         if (status != STATUS_SUCCESS)
         {
+failed_imports:
             /* the module has only be inserted in the load & memory order lists */
             RemoveEntryList(&wm->ldr.InLoadOrderLinks);
             RemoveEntryList(&wm->ldr.InMemoryOrderLinks);
