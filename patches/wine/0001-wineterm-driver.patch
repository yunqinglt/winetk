diff --git a/dlls/wineterm.drv/dllmain.c b/dlls/wineterm.drv/dllmain.c
new file mode 100644
index 0000000000000000000000000000000000000000..2314945a568d31984402c4af4c8f0c8125355719
--- /dev/null
+++ b/dlls/wineterm.drv/dllmain.c
@@ -0,0 +1,21 @@
+/* Terminal graphics driver. Copyright 2026 WineTK contributors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "unixlib.h"
+
+static DWORD WINAPI read_events_thread(void *unused)
+{
+    WINE_UNIX_CALL(term_read_events, NULL);
+    return 0;
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    HANDLE thread;
+    if (reason != DLL_PROCESS_ATTACH) return TRUE;
+    DisableThreadLibraryCalls(instance);
+    if (__wine_init_unix_call() || WINE_UNIX_CALL(term_init, NULL)) return FALSE;
+    /* Running the Unix reader on a Windows thread gives NtUserSendHardwareInput
+     * a valid TEB and lets wineserver wake the actual application GUI thread. */
+    if ((thread = CreateThread(NULL, 0, read_events_thread, NULL, 0, NULL))) CloseHandle(thread);
+    return TRUE;
+}
diff --git a/dlls/wineterm.drv/opengl.c b/dlls/wineterm.drv/opengl.c
new file mode 100644
index 0000000000000000000000000000000000000000..6268661357d0848c5304c70d2bb5b2309bd4961b
--- /dev/null
+++ b/dlls/wineterm.drv/opengl.c
@@ -0,0 +1,341 @@
+/* Surfaceless EGL presentation to the WineTK terminal broker.
+ * Copyright 2026 WineTK contributors.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#if 0
+#pragma makedep unix
+#endif
+#include "config.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "ntstatus.h"
+#include "wine/gdi_driver.h"
+#include "wine/opengl_driver.h"
+#include "wine/winetk_protocol.h"
+#include "termdrv.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(termdrv);
+
+#ifdef SONAME_LIBEGL
+
+static const struct opengl_funcs *funcs;
+static const struct egl_platform *egl;
+static struct opengl_driver_funcs term_driver;
+static const struct opengl_drawable_funcs term_drawable_funcs;
+static BOOL (*egl_context_activate)(struct opengl_context *, struct opengl_drawable *, struct opengl_drawable *);
+static pthread_mutex_t native_buffer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static GLenum native_color_buffer;
+static BOOL metrics_enabled;
+
+struct term_gl_drawable
+{
+    struct opengl_drawable base;
+    SIZE size;
+    unsigned char *pixels;
+    unsigned char *row;
+    HWND registered_hwnd;
+    GLenum native_buffer;
+    pthread_mutex_t mutex;
+    BOOL mutex_initialized;
+    uint64_t metric_start, metric_frames, metric_times[4];
+};
+
+static uint64_t term_clock_ns(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+}
+
+static struct term_gl_drawable *term_gl(struct opengl_drawable *base)
+{
+    return CONTAINING_RECORD(base, struct term_gl_drawable, base);
+}
+
+static void term_set_native_buffer(struct opengl_drawable *base, GLenum buffer)
+{
+    GLenum left = buffer == GL_BACK ? GL_BACK_LEFT : GL_FRONT_LEFT;
+    term_gl(base)->native_buffer = buffer;
+    opengl_drawable_map_buffer(base, GL_FRONT_LEFT, left);
+    opengl_drawable_map_buffer(base, GL_FRONT, buffer);
+    opengl_drawable_map_buffer(base, GL_LEFT, left);
+    opengl_drawable_map_buffer(base, GL_FRONT_AND_BACK, buffer);
+    opengl_drawable_map_buffer(base, GL_BACK_LEFT, left);
+    opengl_drawable_map_buffer(base, GL_BACK, buffer);
+}
+
+static GLenum term_probe_native_buffer(struct opengl_drawable *base)
+{
+    const EGLint attrs[] = {EGL_NONE};
+    EGLContext previous = funcs->p_eglGetCurrentContext(), probe;
+    EGLSurface draw = funcs->p_eglGetCurrentSurface(EGL_DRAW);
+    EGLSurface read = funcs->p_eglGetCurrentSurface(EGL_READ);
+    GLint buffer = GL_FRONT;
+    /* Do not infer the native convention from application state: a context may
+     * already have GL_NONE selected on its default framebuffer. A fresh temporary
+     * context observes the pbuffer defaults without touching application GL state. */
+    if (!(probe = funcs->p_eglCreateContext(egl->display, EGL_NO_CONFIG_KHR, NULL, attrs))) return 0;
+    if (!funcs->p_eglMakeCurrent(egl->display, base->surface, base->surface, probe))
+    {
+        funcs->p_eglDestroyContext(egl->display, probe);
+        return 0;
+    }
+    funcs->p_glGetIntegerv(GL_DRAW_BUFFER, &buffer);
+    if (!funcs->p_eglMakeCurrent(egl->display, draw, read, previous))
+    {
+        funcs->p_eglMakeCurrent(egl->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        funcs->p_eglDestroyContext(egl->display, probe);
+        return 0;
+    }
+    funcs->p_eglDestroyContext(egl->display, probe);
+    return buffer == GL_BACK || buffer == GL_BACK_LEFT ? GL_BACK : GL_FRONT;
+}
+
+static BOOL term_map_native_buffer(struct opengl_drawable *base)
+{
+    struct term_gl_drawable *gl;
+    BOOL result = TRUE;
+    if (!base || base->funcs != &term_drawable_funcs) return TRUE;
+    gl = term_gl(base);
+    pthread_mutex_lock(&gl->mutex);
+    if (gl->native_buffer) goto done;
+    /* Mesa and NVIDIA expose different default buffer conventions for EGL
+     * pbuffers. Cache the platform convention instead of assuming GL_FRONT. */
+    pthread_mutex_lock(&native_buffer_mutex);
+    if (!native_color_buffer)
+    {
+        native_color_buffer = term_probe_native_buffer(base);
+    }
+    if (!native_color_buffer) result = FALSE;
+    else term_set_native_buffer(base, native_color_buffer);
+    pthread_mutex_unlock(&native_buffer_mutex);
+    TRACE("pbuffer %p host color buffer %#x\n", base, gl->native_buffer);
+done:
+    pthread_mutex_unlock(&gl->mutex);
+    return result;
+}
+
+static BOOL term_context_activate(struct opengl_context *context, struct opengl_drawable *draw,
+                                  struct opengl_drawable *read)
+{
+    if (!egl_context_activate(context, draw, read)) return FALSE;
+    if (!term_map_native_buffer(draw)) return FALSE;
+    if (read != draw && !term_map_native_buffer(read)) return FALSE;
+    return TRUE;
+}
+
+static void term_init_egl_platform(struct egl_platform *platform)
+{
+    /* Never resolve a native display or open a compositor connection. */
+    platform->type = EGL_PLATFORM_SURFACELESS_MESA;
+    platform->native_display = 0;
+    platform->force_pbuffer_formats = TRUE;
+    egl = platform;
+}
+
+static BOOL term_resize_drawable(struct term_gl_drawable *gl)
+{
+    SIZE size = gl->base.client->raw ? gl->base.monitor_size : gl->base.virtual_size;
+    EGLint attrs[] = {EGL_WIDTH, size.cx, EGL_HEIGHT, size.cy, EGL_NONE};
+    EGLSurface surface, old = gl->base.surface;
+    EGLSurface draw, read;
+    EGLContext context;
+    unsigned char *pixels, *row;
+    EGLConfig config;
+
+    if (size.cx <= 0 || size.cy <= 0 || size.cx > WT_WINE_MAX_WIDTH || size.cy > WT_WINE_MAX_HEIGHT)
+        return FALSE;
+    if (gl->size.cx == size.cx && gl->size.cy == size.cy) return TRUE;
+    if (!(pixels = malloc((size_t)size.cx * size.cy * 4))) return FALSE;
+    if (!(row = malloc((size_t)size.cx * 4))) { free(pixels); return FALSE; }
+    config = egl->configs[(gl->base.format - 1) % egl->config_count];
+    if (!(surface = funcs->p_eglCreatePbufferSurface(egl->display, config, attrs)))
+    {
+        WARN("failed to allocate %dx%d EGL pbuffer, error %#x\n", (int)size.cx, (int)size.cy,
+             funcs->p_eglGetError());
+        free(pixels);
+        free(row);
+        return FALSE;
+    }
+    draw = funcs->p_eglGetCurrentSurface(EGL_DRAW);
+    read = funcs->p_eglGetCurrentSurface(EGL_READ);
+    context = funcs->p_eglGetCurrentContext();
+    if (old && context && (draw == old || read == old) &&
+        !funcs->p_eglMakeCurrent(egl->display, draw == old ? surface : draw,
+                                read == old ? surface : read, context))
+    {
+        funcs->p_eglDestroySurface(egl->display, surface);
+        free(pixels);
+        free(row);
+        return FALSE;
+    }
+    gl->base.surface = surface;
+    gl->size = size;
+    free(gl->pixels);
+    free(gl->row);
+    gl->pixels = pixels;
+    gl->row = row;
+    if (old) funcs->p_eglDestroySurface(egl->display, old);
+    TRACE("created pbuffer hwnd %p %dx%d\n", gl->base.client->hwnd, (int)size.cx, (int)size.cy);
+    return TRUE;
+}
+
+static void term_drawable_destroy(struct opengl_drawable *base)
+{
+    struct term_gl_drawable *gl = term_gl(base);
+    if (gl->registered_hwnd) term_set_gpu_active(gl->registered_hwnd, FALSE);
+    free(gl->pixels);
+    free(gl->row);
+    if (gl->mutex_initialized) pthread_mutex_destroy(&gl->mutex);
+    /* win32u releases the EGL surface and client reference. */
+}
+
+static BOOL term_readback(struct opengl_drawable *base)
+{
+    static const GLenum pack_names[] = {GL_PACK_ALIGNMENT, GL_PACK_ROW_LENGTH, GL_PACK_SKIP_PIXELS,
+                                       GL_PACK_SKIP_ROWS, GL_PACK_SWAP_BYTES, GL_PACK_LSB_FIRST};
+    static const GLint pack_defaults[] = {4, 0, 0, 0, 0, 0};
+    struct term_gl_drawable *gl = term_gl(base);
+    GLint framebuffer, buffer, pbo, pack[ARRAY_SIZE(pack_names)];
+    unsigned int i, y;
+    size_t stride = (size_t)gl->size.cx * 4;
+    uint64_t marks[5] = {0};
+    BOOL result;
+
+    if (!base->client->hwnd || !gl->pixels) return FALSE;
+    if (metrics_enabled) marks[0] = term_clock_ns();
+    /* Read the pbuffer, regardless of an application's current offscreen FBO or
+     * pack PBO. Restore all touched state before returning to application GL. */
+    funcs->p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &framebuffer);
+    funcs->p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pbo);
+    funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    funcs->p_glGetIntegerv(GL_READ_BUFFER, &buffer);
+    funcs->p_glReadBuffer(gl->native_buffer);
+    funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    for (i = 0; i < ARRAY_SIZE(pack_names); ++i)
+    {
+        funcs->p_glGetIntegerv(pack_names[i], &pack[i]);
+        funcs->p_glPixelStorei(pack_names[i], pack_defaults[i]);
+    }
+    if (metrics_enabled) marks[1] = term_clock_ns();
+    funcs->p_glReadPixels(0, 0, gl->size.cx, gl->size.cy, GL_RGBA, GL_UNSIGNED_BYTE, gl->pixels);
+    if (metrics_enabled) marks[2] = term_clock_ns();
+    for (i = 0; i < ARRAY_SIZE(pack_names); ++i) funcs->p_glPixelStorei(pack_names[i], pack[i]);
+    funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, pbo);
+    funcs->p_glReadBuffer(buffer);
+    funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+
+    /* OpenGL's origin is bottom-left; the terminal protocol is top-down. */
+    for (y = 0; y < gl->size.cy / 2; ++y)
+    {
+        unsigned char *top = gl->pixels + (size_t)y * stride;
+        unsigned char *bottom = gl->pixels + (size_t)(gl->size.cy - 1 - y) * stride;
+        memcpy(gl->row, top, stride);
+        memcpy(top, bottom, stride);
+        memcpy(bottom, gl->row, stride);
+    }
+    for (i = 0; i < (size_t)gl->size.cx * gl->size.cy; ++i) gl->pixels[i * 4 + 3] = 255;
+    if (metrics_enabled) marks[3] = term_clock_ns();
+    result = term_publish_frame(base->client->hwnd, gl->pixels, gl->size.cx, gl->size.cy);
+    if (metrics_enabled)
+    {
+        marks[4] = term_clock_ns();
+        if (!gl->metric_start) gl->metric_start = marks[0];
+        ++gl->metric_frames;
+        for (i = 0; i < 4; ++i) gl->metric_times[i] += marks[i + 1] - marks[i];
+        if (marks[4] - gl->metric_start >= 1000000000)
+        {
+            double scale = gl->metric_frames * 1000000.0;
+            fprintf(stderr, "WINETK_GL_METRICS hwnd=%p frames=%llu fps=%.2f setup_ms=%.3f read_ms=%.3f copy_ms=%.3f send_ms=%.3f\n",
+                    base->client->hwnd, (unsigned long long)gl->metric_frames,
+                    gl->metric_frames * 1000000000.0 / (marks[4] - gl->metric_start),
+                    gl->metric_times[0] / scale, gl->metric_times[1] / scale,
+                    gl->metric_times[2] / scale, gl->metric_times[3] / scale);
+            gl->metric_frames = 0;
+            memset(gl->metric_times, 0, sizeof(gl->metric_times));
+            gl->metric_start = marks[4];
+        }
+    }
+    return result;
+}
+
+static void term_drawable_flush(struct opengl_drawable *base, UINT flags)
+{
+    struct term_gl_drawable *gl = term_gl(base);
+    pthread_mutex_lock(&gl->mutex);
+    if (flags & GL_FLUSH_UPDATED) term_resize_drawable(term_gl(base));
+    /* The terminal owns pacing; an EGL pbuffer has no display refresh. */
+    if (flags & GL_FLUSH_PRESENT) term_readback(base);
+    pthread_mutex_unlock(&gl->mutex);
+}
+
+static BOOL term_drawable_swap(struct opengl_drawable *base)
+{
+    struct term_gl_drawable *gl = term_gl(base);
+    BOOL result;
+    client_surface_present(base->client);
+    pthread_mutex_lock(&gl->mutex);
+    result = term_readback(base);
+    pthread_mutex_unlock(&gl->mutex);
+    return result;
+}
+
+static const struct opengl_drawable_funcs term_drawable_funcs =
+{
+    .size = sizeof(struct term_gl_drawable),
+    .destroy = term_drawable_destroy,
+    .flush = term_drawable_flush,
+    .swap = term_drawable_swap,
+};
+
+static BOOL term_surface_create(struct client_surface *client, int format, struct opengl_drawable **drawable)
+{
+    struct term_gl_drawable *gl;
+    if (!(gl = opengl_drawable_create(&term_drawable_funcs, format, client, NULL))) return FALSE;
+    if (pthread_mutex_init(&gl->mutex, NULL)) { opengl_drawable_release(&gl->base); return FALSE; }
+    gl->mutex_initialized = TRUE;
+    /* EGL pbuffers have one color buffer. WGL's emulated front/back aliases both
+     * address it; presentation reads it before the next application frame. */
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT_LEFT, GL_FRONT);
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT, GL_FRONT);
+    opengl_drawable_map_buffer(&gl->base, GL_LEFT, GL_FRONT);
+    opengl_drawable_map_buffer(&gl->base, GL_FRONT_AND_BACK, GL_FRONT);
+    opengl_drawable_map_buffer(&gl->base, GL_BACK_LEFT, GL_FRONT);
+    opengl_drawable_map_buffer(&gl->base, GL_BACK, GL_FRONT);
+    if (!term_resize_drawable(gl)) { opengl_drawable_release(&gl->base); return FALSE; }
+    gl->registered_hwnd = client->hwnd;
+    term_set_gpu_active(gl->registered_hwnd, TRUE);
+    *drawable = &gl->base;
+    return TRUE;
+}
+
+UINT TERM_OpenGLInit(UINT version, const struct opengl_funcs *opengl_funcs,
+                    const struct opengl_driver_funcs **driver_funcs)
+{
+    if (version != WINE_OPENGL_DRIVER_VERSION) return STATUS_INVALID_PARAMETER;
+    if (!opengl_funcs->egl_handle) return STATUS_NOT_SUPPORTED;
+    funcs = opengl_funcs;
+    metrics_enabled = getenv("WINETK_GL_METRICS") && !strcmp(getenv("WINETK_GL_METRICS"), "1");
+    /* Reuse Wine's EGL contexts, formats, extensions and pbuffers. Only an
+     * onscreen drawable's storage and presentation are terminal specific. */
+    term_driver = **driver_funcs;
+    egl_context_activate = term_driver.p_context_activate;
+    term_driver.p_init_egl_platform = term_init_egl_platform;
+    term_driver.p_surface_create = term_surface_create;
+    term_driver.p_context_activate = term_context_activate;
+    *driver_funcs = &term_driver;
+    return STATUS_SUCCESS;
+}
+
+#else
+
+UINT TERM_OpenGLInit(UINT version, const struct opengl_funcs *opengl_funcs,
+                    const struct opengl_driver_funcs **driver_funcs)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif
