+WINE_DEFAULT_DEBUG_CHANNEL(termdrv);
+
+C_ASSERT(sizeof(struct wt_wine_header) == 16);
+C_ASSERT(sizeof(struct wt_wine_window) == 48);
+C_ASSERT(sizeof(struct wt_wine_destroy) == 16);
+C_ASSERT(sizeof(struct wt_wine_input) == 32);
+
+#define DEFAULT_DESKTOP_WIDTH 800
+#define DEFAULT_DESKTOP_HEIGHT 600
+#define SEND_TIMEOUT_MS 250
+
+static int connection = -1;
+static BOOL broken;
+static UINT desktop_width = DEFAULT_DESKTOP_WIDTH, desktop_height = DEFAULT_DESKTOP_HEIGHT;
+static UINT desktop_depth = 32, desktop_frequency = 60;
+static pthread_mutex_t send_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t geometry_mutex = PTHREAD_MUTEX_INITIALIZER;
+/* A window may have several OpenGL drawables during context replacement.
+ * Bound bookkeeping rather than growing on every untrusted HWND creation. */
+static struct { HWND hwnd; UINT refs; } gpu_windows[128];
+
+void term_set_gpu_active(HWND hwnd, BOOL active)
+{
+    UINT i, empty = ARRAYSIZE(gpu_windows);
+    pthread_mutex_lock(&geometry_mutex);
+    for (i = 0; i < ARRAYSIZE(gpu_windows); ++i)
+    {
+        if (!gpu_windows[i].refs && empty == ARRAYSIZE(gpu_windows)) empty = i;
+        if (gpu_windows[i].hwnd != hwnd || !gpu_windows[i].refs) continue;
+        if (active) gpu_windows[i].refs++;
+        else if (!--gpu_windows[i].refs) gpu_windows[i].hwnd = NULL;
+        break;
+    }
+    if (active && i == ARRAYSIZE(gpu_windows))
+    {
+        if (empty < ARRAYSIZE(gpu_windows))
+        {
+            gpu_windows[empty].hwnd = hwnd;
+            gpu_windows[empty].refs = 1;
+        }
+        else WARN("too many OpenGL client windows to suppress GDI output\n");
+    }
+    pthread_mutex_unlock(&geometry_mutex);
+}
+
+/* Called only while holding geometry_mutex. */
+static BOOL has_gpu_client(HWND hwnd)
+{
+    UINT i;
+    for (i = 0; i < ARRAYSIZE(gpu_windows); ++i)
+        if (gpu_windows[i].hwnd == hwnd && gpu_windows[i].refs) return TRUE;
+    return FALSE;
+}
+
+struct term_surface
+{
+    struct window_surface header;
+    RECT visible, client;
+    BOOL visible_flag;
+    unsigned char *rgba;
+    size_t rgba_capacity;
+};
+
+static uint64_t monotonic_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+/* Nonblocking sends and one deadline for an entire frame avoid an indefinitely
+ * blocked Wine GUI thread when a terminal/broker stops consuming output. */
+static BOOL send_bytes(const void *buffer, size_t length, uint64_t deadline)
+{
+    const char *bytes = buffer;
+    while (length)
+    {
+        ssize_t sent = send(connection, bytes, length, MSG_NOSIGNAL | MSG_DONTWAIT);
+        if (sent > 0) { bytes += sent; length -= sent; continue; }
+        if (sent < 0 && errno == EINTR) continue;
+        if (sent < 0 && (errno == EAGAIN))
+        {
+            struct pollfd fd = {connection, POLLOUT, 0};
+            uint64_t now = monotonic_ms();
+            int remaining, ready;
+            if (now >= deadline) return FALSE;
+            remaining = deadline - now;
+            ready = poll(&fd, 1, remaining);
+            if (ready < 0 && errno == EINTR) continue;
+            if (ready > 0 && (fd.revents & POLLOUT)) continue;
+        }
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL send_message(UINT type, const void *payload, UINT size, const void *pixels, UINT pixel_size)
+{
+    struct wt_wine_header header = {WT_WINE_MAGIC, WT_WINE_VERSION, type, size + pixel_size};
+    BOOL ok = FALSE;
+    uint64_t deadline;
+    pthread_mutex_lock(&send_mutex);
+    deadline = monotonic_ms() + SEND_TIMEOUT_MS;
+    if (!broken && connection != -1)
+    {
+        ok = send_bytes(&header, sizeof(header), deadline) &&
+             send_bytes(payload, size, deadline) &&
+             (!pixel_size || send_bytes(pixels, pixel_size, deadline));
+        if (!ok)
+        {
+            WARN("terminal connection failed or exceeded %u ms; stopping transfer\n", SEND_TIMEOUT_MS);
+            broken = TRUE;
+            /* Keep the fd number stable for the concurrent reader. No reconnect
+             * on a partially transmitted frame: that would corrupt framing. */
+            shutdown(connection, SHUT_RDWR);
+        }
+    }
+    pthread_mutex_unlock(&send_mutex);
+    return ok;
+}
+
+static BOOL read_bytes(void *buffer, size_t size)
+{
+    char *bytes = buffer;
+    while (size)
+    {
+        ssize_t got = recv(connection, bytes, size, 0);
+        if (got > 0) { bytes += got; size -= got; continue; }
+        if (got < 0 && errno == EINTR) continue;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* A terminal canvas has no fixed host monitor mode. Report common legacy game
+ * modes and retain the mode selected by ChangeDisplaySettings in this process. */
+static UINT term_update_display_devices(const struct gdi_device_manager *manager, void *param)
+{
+    static const UINT dimensions[][2] = {{320,240}, {640,480}, {800,600}, {1024,768},
+                                        {1280,720}, {1280,960}, {1600,900}, {1920,1080}};
+    struct pci_id pci = {0};
+    struct gdi_monitor monitor = {0};
+    DEVMODEW modes[ARRAYSIZE(dimensions) * 2 + 1], current = {.dmSize = sizeof(current)};
+    UINT count = 0, i, depth;
+    pthread_mutex_lock(&geometry_mutex);
+    current.dmFields = DM_POSITION | DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH |
+                       DM_PELSHEIGHT | DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY;
+    current.dmBitsPerPel = desktop_depth;
+    current.dmPelsWidth = desktop_width;
+    current.dmPelsHeight = desktop_height;
+    current.dmDisplayFrequency = desktop_frequency;
+    pthread_mutex_unlock(&geometry_mutex);
+    manager->add_gpu("WineTK terminal display", &pci, NULL, param);
+    manager->add_source("WineTK terminal", DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE, 96, param);
+    SetRect(&monitor.rc_monitor, 0, 0, current.dmPelsWidth, current.dmPelsHeight);
+    monitor.rc_work = monitor.rc_monitor;
+    manager->add_monitor(&monitor, param);
+    modes[count++] = current;
+    for (depth = 16; depth <= 32; depth += 16)
+        for (i = 0; i < ARRAYSIZE(dimensions); ++i)
+        {
+            DEVMODEW *mode;
+            if (depth == current.dmBitsPerPel && dimensions[i][0] == current.dmPelsWidth &&
+                dimensions[i][1] == current.dmPelsHeight) continue;
+            mode = &modes[count++];
+            *mode = current;
+            mode->dmPelsWidth = dimensions[i][0];
+            mode->dmPelsHeight = dimensions[i][1];
+            mode->dmBitsPerPel = depth;
+        }
+    manager->add_modes(&current, count, modes, param);
+    return STATUS_SUCCESS;
+}
+
+static LONG term_change_display_settings(DEVMODEW *displays, const WCHAR *primary_name,
+                                         HWND hwnd, DWORD flags, void *param)
+{
+    DEVMODEW *mode = displays;
+    if (!mode || !mode->dmSize || !mode->dmPelsWidth || !mode->dmPelsHeight ||
+        mode->dmPelsWidth > WT_WINE_MAX_WIDTH || mode->dmPelsHeight > WT_WINE_MAX_HEIGHT ||
+        (mode->dmBitsPerPel != 16 && mode->dmBitsPerPel != 32)) return DISP_CHANGE_BADMODE;
+    /* There is exactly one virtual display. Wine validates requested modes and
+     * updates its shared display registry/cache after this callback succeeds. */
+    if (((DEVMODEW *)((char *)mode + mode->dmSize + mode->dmDriverExtra))->dmSize)
+        return DISP_CHANGE_BADPARAM;
+    pthread_mutex_lock(&geometry_mutex);
+    desktop_width = mode->dmPelsWidth;
+    desktop_height = mode->dmPelsHeight;
+    desktop_depth = mode->dmBitsPerPel;
+    desktop_frequency = mode->dmDisplayFrequency ? mode->dmDisplayFrequency : 60;
+    pthread_mutex_unlock(&geometry_mutex);
+    TRACE("display mode %ux%u %u bpp %u Hz\n", desktop_width, desktop_height,
+          desktop_depth, desktop_frequency);
+    return DISP_CHANGE_SUCCESSFUL;
+}
+
+static void describe_client(struct wt_wine_window *window, const RECT *client)
+{
+    window->client_x = client->left;
+    window->client_y = client->top;
+    window->client_width = max(0, client->right - client->left);
+    window->client_height = max(0, client->bottom - client->top);
+}
+
+/* Called by the surfaceless EGL swap path. Pixel storage is top-down RGBA8;
+ * query the client origin so that no titlebar offsets reach the GPU canvas. */
+BOOL term_publish_frame(HWND hwnd, const void *rgba, UINT width, UINT height)
+{
+    struct wt_wine_window frame = {0};
+    RECT client;
+    POINT origin = {0};
+    if (!rgba || !width || !height || width > WT_WINE_MAX_WIDTH || height > WT_WINE_MAX_HEIGHT ||
+        !NtUserGetClientRect(hwnd, &client, 96) || !NtUserClientToScreen(hwnd, &origin)) return FALSE;
+    if (client.right - client.left > WT_WINE_MAX_WIDTH ||
+        client.bottom - client.top > WT_WINE_MAX_HEIGHT) return FALSE;
+    OffsetRect(&client, origin.x, origin.y);
+    frame.hwnd = HandleToULong(hwnd);
+    frame.pid = getpid();
+    frame.x = client.left;
+    frame.y = client.top;
+    frame.width = width;
+    frame.height = height;
+    frame.flags = WT_WINE_VISIBLE | WT_WINE_GPU;
+    if (NtUserGetForegroundWindow() == hwnd) frame.flags |= WT_WINE_FOREGROUND;
+    describe_client(&frame, &client);
+    return send_message(WT_WINE_FRAME, &frame, sizeof(frame), rgba, width * height * 4);
+}
+
+static void term_set_clip(struct window_surface *surface, const RECT *rects, UINT count) {}
+static void term_surface_destroy(struct window_surface *surface)
+{
+    struct term_surface *term = (struct term_surface *)surface;
+    free(term->rgba);
+}
+
+static BOOL term_surface_flush(struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                               const BITMAPINFO *info, const void *bits, BOOL shape_changed,
+                               const BITMAPINFO *shape_info, const void *shape_bits)
+{
+    struct term_surface *term = (struct term_surface *)surface;
+    struct wt_wine_window frame;
+    const BITMAPINFOHEADER *bitmap = &info->bmiHeader;
+    const unsigned char *src = bits;
+    unsigned char *rgba;
+    RECT visible, client;
+    BOOL visible_flag, ok;
+    int left, top, right, bottom, width, height, x, y, stride, source_height;
+
+    pthread_mutex_lock(&geometry_mutex);
+    visible = term->visible;
+    client = term->client;
+    visible_flag = term->visible_flag && !has_gpu_client(surface->hwnd);
+    pthread_mutex_unlock(&geometry_mutex);
+    if (!visible_flag) return TRUE;
+    /* An unsupported oversized client must not send invalid metadata and
+     * disconnect other windows sharing this process's terminal connection. */
+    if (client.right - client.left > WT_WINE_MAX_WIDTH ||
+        client.bottom - client.top > WT_WINE_MAX_HEIGHT) return TRUE;
+    if (bitmap->biBitCount != 32 || bitmap->biWidth <= 0 || !bitmap->biHeight) return FALSE;
+    source_height = abs(bitmap->biHeight);
+    left = max(0, max(visible.left, client.left) - visible.left - rect->left);
+    top = max(0, max(visible.top, client.top) - visible.top - rect->top);
+    right = min(bitmap->biWidth, min(visible.right, client.right) - visible.left - rect->left);
+    bottom = min(source_height, min(visible.bottom, client.bottom) - visible.top - rect->top);
+    width = right - left;
+    height = bottom - top;
+    if (width <= 0 || height <= 0) return TRUE;
+    if (width > WT_WINE_MAX_WIDTH || height > WT_WINE_MAX_HEIGHT) return FALSE;
+    if ((size_t)width * height * 4 > term->rgba_capacity)
+    {
+        size_t capacity = (size_t)width * height * 4;
+        if (!(rgba = realloc(term->rgba, capacity))) return FALSE;
+        term->rgba = rgba;
+        term->rgba_capacity = capacity;
+    }
+    rgba = term->rgba;
+    stride = bitmap->biWidth * 4;
+    for (y = 0; y < height; ++y)
+    {
+        int row = bitmap->biHeight < 0 ? top + y : source_height - 1 - top - y;
+        const unsigned char *in = src + (size_t)row * stride + left * 4;
+        unsigned char *out = rgba + (size_t)y * width * 4;
+        for (x = 0; x < width; ++x)
+        {
+            out[x * 4] = in[x * 4 + 2];
+            out[x * 4 + 1] = in[x * 4 + 1];
+            out[x * 4 + 2] = in[x * 4];
+            out[x * 4 + 3] = 255;
+        }
+    }
+    memset(&frame, 0, sizeof(frame));
+    frame.hwnd = HandleToULong(surface->hwnd);
+    frame.pid = getpid();
+    frame.x = visible.left + rect->left + left;
+    frame.y = visible.top + rect->top + top;
+    frame.width = width;
+    frame.height = height;
+    frame.flags = WT_WINE_VISIBLE;
+    describe_client(&frame, &client);
+    if (NtUserGetForegroundWindow() == surface->hwnd) frame.flags |= WT_WINE_FOREGROUND;
+    ok = send_message(WT_WINE_FRAME, &frame, sizeof(frame), rgba, width * height * 4);
+    TRACE("frame hwnd %p %ux%u at %d,%d ok %d\n", surface->hwnd, frame.width, frame.height, frame.x, frame.y, ok);
+    return ok;
+}
+
+static const struct window_surface_funcs term_surface_funcs =
+{
+    .size = sizeof(struct term_surface),
+    .set_clip = term_set_clip,
+    .flush = term_surface_flush,
+    .destroy = term_surface_destroy,
+};
+
+static BOOL term_create_window_surface(HWND hwnd, BOOL layered, const RECT *rect, struct window_surface **surface)
+{
+    BITMAPINFO info = {0};
+    struct window_surface *previous = *surface;
+    int width = rect->right - rect->left, height = rect->bottom - rect->top;
+    if (previous && previous->funcs == &term_surface_funcs) return TRUE;
+    if (width <= 0 || height <= 0 || width > WT_WINE_MAX_WINDOW_WIDTH || height > WT_WINE_MAX_WINDOW_HEIGHT) return FALSE;
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    info.bmiHeader.biSizeImage = width * height * 4;
+    *surface = window_surface_create(&term_surface_funcs, hwnd, rect, &info, 0);
+    if (previous) window_surface_release(previous);
+    TRACE("created hwnd %p surface %p rect %s\n", hwnd, *surface, wine_dbgstr_rect(rect));
+    return *surface != NULL;
+}
+
+static BOOL term_window_pos_changing(HWND hwnd, UINT flags, BOOL shaped, const struct window_rects *rects)
+{
+    return TRUE;
+}
+
+static void term_window_pos_changed(HWND hwnd, HWND insert_after, HWND owner_hint, UINT flags,
+                                    const struct window_rects *rects, struct window_surface *surface)
+{
+    struct wt_wine_window window = {0};
+    BOOL visible = NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_VISIBLE;
+    HWND parent = NtUserGetAncestor(hwnd, GA_PARENT);
+    if (parent && parent != NtUserGetDesktopWindow()) return;
+    if (surface && surface->funcs == &term_surface_funcs)
+    {
+        struct term_surface *term = (struct term_surface *)surface;
+        pthread_mutex_lock(&geometry_mutex);
+        term->visible = rects->visible;
+        term->client = rects->client;
+        term->visible_flag = visible;
+        pthread_mutex_unlock(&geometry_mutex);
+    }
+    window.hwnd = HandleToULong(hwnd);
+    window.pid = getpid();
+    window.x = rects->visible.left;
+    window.y = rects->visible.top;
+    window.width = max(0, rects->visible.right - rects->visible.left);
+    window.height = max(0, rects->visible.bottom - rects->visible.top);
+    window.flags = visible ? WT_WINE_VISIBLE : 0;
+    describe_client(&window, &rects->client);
+    if (NtUserGetForegroundWindow() == hwnd) window.flags |= WT_WINE_FOREGROUND;
+    if (window.width <= WT_WINE_MAX_WINDOW_WIDTH && window.height <= WT_WINE_MAX_WINDOW_HEIGHT &&
+        window.client_width <= WT_WINE_MAX_WIDTH && window.client_height <= WT_WINE_MAX_HEIGHT)
+        send_message(WT_WINE_WINDOW, &window, sizeof(window), NULL, 0);
+}
+
+static void term_destroy_window(HWND hwnd)
+{
+    struct wt_wine_destroy destroy = {HandleToULong(hwnd), getpid(), 0};
+    UINT i;
+    pthread_mutex_lock(&geometry_mutex);
+    for (i = 0; i < ARRAYSIZE(gpu_windows); ++i)
+        if (gpu_windows[i].hwnd == hwnd) memset(&gpu_windows[i], 0, sizeof(gpu_windows[i]));
+    pthread_mutex_unlock(&geometry_mutex);
+    send_message(WT_WINE_DESTROY, &destroy, sizeof(destroy), NULL, 0);
+}
+
+static BOOL term_create_desktop(const WCHAR *name, UINT width, UINT height)
+{
+    if (width && height && width <= WT_WINE_MAX_WINDOW_WIDTH && height <= WT_WINE_MAX_WINDOW_HEIGHT)
+    {
+        pthread_mutex_lock(&geometry_mutex);
+        desktop_width = width;
+        desktop_height = height;
+        pthread_mutex_unlock(&geometry_mutex);
+    }
+    return TRUE;
+}
+static BOOL term_create_window(HWND hwnd) { return TRUE; }
+static BOOL term_set_cursor_pos(INT x, INT y) { return TRUE; }
+static BOOL term_clip_cursor(const RECT *rect, BOOL reset) { return TRUE; }
+
+static const struct user_driver_funcs term_driver =
+{
+    .pUpdateDisplayDevices = term_update_display_devices,
+    .pChangeDisplaySettings = term_change_display_settings,
+    .pOpenGLInit = TERM_OpenGLInit,
+    .pCreateDesktop = term_create_desktop,
+    .pCreateWindow = term_create_window,
+    .pDestroyWindow = term_destroy_window,
+    .pSetCursorPos = term_set_cursor_pos,
+    .pClipCursor = term_clip_cursor,
+    .pWindowPosChanging = term_window_pos_changing,
+    .pWindowPosChanged = term_window_pos_changed,
+    .pCreateWindowSurface = term_create_window_surface,
+};
+
+static NTSTATUS init(void *unused)
+{
+    struct sockaddr_un address = {0};
+    int send_buffer = 4 * 1024 * 1024;
+    const char *path = getenv("WINETK_SOCKET"), *fps_env = getenv("WINETK_FPS");
+    const char *size_env = getenv("WINETK_DESKTOP_SIZE");
+    if (size_env && *size_env)
+    {
+        char tail;
+        UINT width, height;
+        if (sscanf(size_env, "%ux%u%c", &width, &height, &tail) == 2 &&
+            width >= 64 && height >= 64 && width <= WT_WINE_MAX_WINDOW_WIDTH &&
+            height <= WT_WINE_MAX_WINDOW_HEIGHT)
+        {
+            desktop_width = width;
+            desktop_height = height;
+        }
+    }
+    if (fps_env && *fps_env)
+    {
+        char *end;
+        unsigned long fps = strtoul(fps_env, &end, 10);
+        if (!*end && fps >= 1 && fps <= 240) desktop_frequency = fps;
+    }
+    if (!path || !*path || strlen(path) >= sizeof(address.sun_path)) return STATUS_UNSUCCESSFUL;
+    if ((connection = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0)) == -1) return STATUS_UNSUCCESSFUL;
+    /* Full-frame local transport needs room for several 640x480 frames.
+     * A bounded larger queue avoids GUI stalls while the broker encodes Kitty. */
+    setsockopt(connection, SOL_SOCKET, SO_SNDBUF, &send_buffer, sizeof(send_buffer));
+    address.sun_family = AF_UNIX;
+    strcpy(address.sun_path, path);
+    if (connect(connection, (struct sockaddr *)&address, sizeof(address)) == -1)
+    {
+        WARN("cannot connect to WineTK broker %s: %s\n", path, strerror(errno));
+        close(connection);
+        connection = -1;
+        return STATUS_UNSUCCESSFUL;
+    }
+    __wine_set_user_driver(&term_driver, WINE_GDI_DRIVER_VERSION);
+    TRACE("terminal display driver initialized, %ux%u\n", desktop_width, desktop_height);
+    return STATUS_SUCCESS;
+}
+
+static void send_unicode(HWND hwnd, WORD unit)
+{
+    INPUT event = {0};
+    event.type = INPUT_KEYBOARD;
+    event.ki.wScan = unit;
+    event.ki.dwFlags = KEYEVENTF_UNICODE;
+    NtUserSendHardwareInput(hwnd, 0, &event, 0);
+    event.ki.dwFlags |= KEYEVENTF_KEYUP;
+    NtUserSendHardwareInput(hwnd, 0, &event, 0);
+}
+
+/* The null-driver US keyboard fallback searches numpad entries before their
+ * E0 navigation equivalents even for MAPVK_VK_TO_VSC_EX. Terminal navigation
+ * keys are unambiguous, so retain their physical E0 scans explicitly. */
+static UINT physical_key_scan(UINT key)
+{
+    switch (key)
+    {
+    case VK_PRIOR: return 0xe049;
+    case VK_NEXT: return 0xe051;
+    case VK_END: return 0xe04f;
+    case VK_HOME: return 0xe047;
+    case VK_LEFT: return 0xe04b;
+    case VK_UP: return 0xe048;
+    case VK_RIGHT: return 0xe04d;
+    case VK_DOWN: return 0xe050;
+    case VK_INSERT: return 0xe052;
+    case VK_DELETE: return 0xe053;
+    default: return NtUserMapVirtualKeyEx(key, MAPVK_VK_TO_VSC_EX, 0);
+    }
+}
+
+static NTSTATUS read_events(void *unused)
+{
+    struct wt_wine_header header;
+    struct wt_wine_input input;
+    while (read_bytes(&header, sizeof(header)))
+    {
+        INPUT event = {0};
+        HWND hwnd;
+        if (header.magic != WT_WINE_MAGIC || header.version != WT_WINE_VERSION ||
+            header.type != WT_WINE_INPUT || header.size != sizeof(input) || !read_bytes(&input, sizeof(input))) break;
+        hwnd = ULongToHandle((ULONG)input.hwnd);
+        /* A private same-uid socket is still untrusted input. Never address a
+         * window owned by another Wine process. */
+        if (!hwnd || HandleToULong(NtUserQueryWindow(hwnd, WindowProcess)) != GetCurrentProcessId()) continue;
+        switch (input.kind)
+        {
+        case WT_WINE_FOCUS:
+            if (input.value) NtUserSetForegroundWindow(hwnd);
+            break;
+        case WT_WINE_CLOSE:
+            NtUserPostMessage(hwnd, WM_CLOSE, 0, 0);
+            break;
+        case WT_WINE_KEY:
+        {
+            UINT scan;
+            if (input.code > 255) break;
+            scan = physical_key_scan(input.code);
+            event.type = INPUT_KEYBOARD;
+            event.ki.wVk = input.code;
+            event.ki.wScan = scan & 0xff;
+            event.ki.dwFlags = input.value ? 0 : KEYEVENTF_KEYUP;
+            if (scan & ~0xff) event.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+            /* Wine's keyboard hardware path automatically dispatches RawInput.
+             * Preserve E0/E1 scan prefixes as EXTENDEDKEY so DirectInput sees
+             * arrows/navigation keys instead of their numpad counterparts. */
+            NtUserSendHardwareInput(hwnd, 0, &event, 0);
+            TRACE("key hwnd %p vk %#x scan %#x flags %#x\n", hwnd, input.code, scan, event.ki.dwFlags);
+            break;
+        }
+        case WT_WINE_TEXT:
+            if (input.code > 0x10ffff || (input.code >= 0xd800 && input.code <= 0xdfff)) break;
+            if (input.code > 0xffff)
+            {
+                UINT scalar = input.code - 0x10000;
+                send_unicode(hwnd, 0xd800 + (scalar >> 10));
+                send_unicode(hwnd, 0xdc00 + (scalar & 1023));
+            }
+            else send_unicode(hwnd, input.code);
+            break;
+        case WT_WINE_MOVE:
+        case WT_WINE_BUTTON:
+        case WT_WINE_WHEEL:
+            event.type = INPUT_MOUSE;
+            event.mi.dx = input.x;
+            event.mi.dy = input.y;
+            event.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE;
+            if (input.kind == WT_WINE_BUTTON)
+            {
+                static const DWORD down[] = {0, MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_RIGHTDOWN};
+                static const DWORD up[] = {0, MOUSEEVENTF_LEFTUP, MOUSEEVENTF_MIDDLEUP, MOUSEEVENTF_RIGHTUP};
+                if (input.code < 1 || input.code > 3) break;
+                if (input.value) NtUserSetForegroundWindow(hwnd);
+                event.mi.dwFlags |= input.value ? down[input.code] : up[input.code];
+            }
+            else if (input.kind == WT_WINE_WHEEL)
+            {
+                if (input.value < -120 || input.value > 120) break;
+                event.mi.dwFlags |= MOUSEEVENTF_WHEEL;
+                event.mi.mouseData = input.value * WHEEL_DELTA;
+            }
+            NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &event, 0);
+            event.mi.dwFlags = MOUSEEVENTF_MOVE_NOCOALESCE;
+            NtUserSendHardwareInput(NULL, SEND_HWMSG_RAWINPUT, &event, 0);
+            break;
+        }
+    }
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] = {init, read_events};
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == term_unix_count);
+#ifdef _WIN64
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] = {init, read_events};
+C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == term_unix_count);
+#endif
